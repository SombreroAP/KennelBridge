<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KennelBridge</AssemblyName>
    <RootNamespace>KennelBridge</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <!-- lets the project build from macOS/Linux too -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <Version>1.1.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.png" LogicalName="app.png" />
    <EmbeddedResource Include="overlay\index.html" LogicalName="overlay/index.html" />
    <EmbeddedResource Include="overlay\app.js" LogicalName="overlay/app.js" />
    <EmbeddedResource Include="overlay\style.css" LogicalName="overlay/style.css" />
    <EmbeddedResource Include="overlay\three.min.js" LogicalName="overlay/three.min.js" />
    <EmbeddedResource Include="overlay\pad3d.js" LogicalName="overlay/pad3d.js" />
    <EmbeddedResource Include="overlay\GLTFLoader.js" LogicalName="overlay/GLTFLoader.js" />
    <EmbeddedResource Include="models\dualsense.glb" LogicalName="models/dualsense.glb" />
    <EmbeddedResource Include="models\dualsense.json" LogicalName="models/dualsense.json" />
    <EmbeddedResource Include="models\dualshock4.glb" LogicalName="models/dualshock4.glb" />
    <EmbeddedResource Include="models\dualshock4.json" LogicalName="models/dualshock4.json" />
    <EmbeddedResource Include="models\xbox.glb" LogicalName="models/xbox.glb" />
    <EmbeddedResource Include="models\xbox.json" LogicalName="models/xbox.json" />
  </ItemGroup>

</Project>
